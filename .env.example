# Portal Session Secret (encrypts in-flight CAPTCHA / OTP portal tokens)
# Generate with: openssl rand -base64 32
PORTAL_SESSION_SECRET=

# AU75 Administrator Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Admin Session Encryption Secret (AES-256-GCM sealed cookies)
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=

# Supabase PostgreSQL Database (Global persistent maintenance configuration)
# Found in: Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
